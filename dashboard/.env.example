# Either set one complete SQLAlchemy URL:
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/flights_db

# Or configure the individual PostgreSQL variables instead:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=flights_db
# PGUSER=postgres
# PGPASSWORD=your_password

# Optional Dash runtime settings:
# PORT=8050
# DASH_DEBUG=false
